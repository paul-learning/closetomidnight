# Pflicht. Zum lokalen Testen reicht: ADMIN_SECRET=test
ADMIN_SECRET=test
# Lokal weglassen; auf dem Server die öffentliche Adresse, z. B. https://fvz.example.com
# BASE_URL=
# Auf dem Server hinter Caddy: 1 (damit die Sperre bei falschen Passwörtern die echte Besucheradresse sieht)
# TRUST_PROXY=1

# Optional: KI-Zeitung (ohne Schlüssel gibt es eine schlichte Zusammenfassung)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Optional: Kontakt für Push-Dienste (Apple/Google), mailto:… oder https://…; leer = BASE_URL
# PUSH_CONTACT=mailto:du@example.org

# Uhrzeiten (Ortszeit der Spielgruppe)
RESOLVE_HOUR=21
REMIND_HOUR=18
# TIME_ZONE=Europe/Berlin
